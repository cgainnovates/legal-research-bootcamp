{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/payments/verify/:reference",
      "destination": "/api/payments/verify?reference=:reference"
    },
    {
      "source": "/api/payments/registration/:registrationId",
      "destination": "/api/payments/registration?registrationId=:registrationId"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
