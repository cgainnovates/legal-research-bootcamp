# Copy this file to backend/.env and frontend/.env as described in the README.
# NEVER commit real API keys.

# --- Backend (backend/.env) ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Paystack keys from https://dashboard.paystack.com/#/settings/developer
# Use test keys while developing. Use live keys only in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. If Paystack sends webhooks, set this to the secret from the dashboard.
PAYSTACK_WEBHOOK_SECRET=

# --- Frontend (frontend/.env) ---
# Vite only exposes variables prefixed with VITE_
VITE_API_URL=http://localhost:4000
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
